# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# Mount point       FS           Device               2nd Device                 Flags
/boot               emmc         /dev/block/bootdevice/by-name/boot              flags=backup=1;display="Boot Image";flashimg=1
/recovery           emmc         /dev/block/bootdevice/by-name/recovery          flags=backup=1;display="Recovery Image";flashimg=1
/misc               emmc         /dev/block/bootdevice/by-name/misc              flags=backup=1;display="Misc Image"
/vbmeta             emmc         /dev/block/bootdevice/by-name/vbmeta            flags=backup=1;display="Vbmeta Image"
/vbmetabak          emmc         /dev/block/bootdevice/by-name/vbmetabak         flags=backup=1;display="Vbmeta Backup Image"
/vbmeta_system      emmc         /dev/block/bootdevice/by-name/vbmeta_system     flags=backup=1;display="Vbmeta System imafe"

# Logical Points
system              /system_root    ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
system              /system_root    erofs       ro                                  wait,logical,first_stage_mount
vendor              /vendor         ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
vendor              /vendor         erofs       ro                                  wait,logical,first_stage_mount
product             /product        ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
product             /product        erofs       ro                                  wait,logical,first_stage_mount
odm                 /odm            ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
odm                 /odm            erofs       ro                                  wait,logical,first_stage_mount

# Direct image flashing
/system_image       emmc         /dev/block/bootdevice/by-name/system            flags=backup=1;flashimg=1;display="System Image"
/odm_image          emmc         /dev/block/bootdevice/by-name/odm               flags=backup=1;flashimg=1;display="ODM Image"
/product_image      emmc         /dev/block/bootdevice/by-name/product           flags=backup=1;flashimg=1;display="Product Image"
/vendor_image       emmc         /dev/block/bootdevice/by-name/vendor            flags=backup=1;flashimg=1;display="Vendor Image"

# ETC Moint Point
/cache              ext4         /dev/block/bootdevice/by-name/cache             flags=display="Cache";backup=1;wipeingui
/custom             ext4         /dev/block/bootdevice/by-name/custom            flags=display="Custom";backup=1;wipeingui
/metadata           ext4         /dev/block/bootdevice/by-name/metadata          flags=display="Metadata";backup=1;wipeingui
/data               ext4         /dev/block/bootdevice/by-name/userdata          flags=display="Data";backup=1;wipeingui


# SD Card & USB-OTG Points
/sdcard1            auto         /dev/block/mmcblk0p1  /dev/block/mmcblk0        flags=display="MicroSD";storage;wipeingui;removable
/usb_otg            auto         /dev/block/sdg1       /dev/block/sdg            flags=display="USB-Storage";storage;wipeingui;removable